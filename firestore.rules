rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user requesting access is an Admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // 1. Anyone can create their own profile during the "Request Access" signup step
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // 2. Users can read their own profile. Admins can read EVERYONE'S profile.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // 3. ONLY Admins are allowed to update profiles (e.g., to Approve or Reject users)
      allow update: if request.auth != null && isAdmin();
      
      // 4. Deletions are completely blocked for security tracking
      allow delete: if false;
      
      // --- NEW RULES FOR SENSOR HISTORY ---
      match /history/{historyId} {
        // A user can save their own sensor data.
        allow create: if request.auth != null && request.auth.uid == userId;
        // A user can view their own data, and Admins can view ANY user's data.
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Once saved, historical data cannot be tampered with or deleted.
        allow update, delete: if false;
      }
    }
  }
}
